{
  "name": "mood-garden",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @mood-garden/api\" \"npm run dev -w @mood-garden/web\"",
    "build": "npm run db:generate && npm run build --workspaces",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @mood-garden/api",
    "db:validate": "npm run db:validate -w @mood-garden/api",
    "db:migrate": "npm run db:migrate -w @mood-garden/api --",
    "db:studio": "npm run db:studio -w @mood-garden/api"
  },
  "overrides": {
    "multer": "^2.3.0",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
